From 13cb05183f7ea2c61eb8e8b890440a6828605f8d Mon Sep 17 00:00:00 2001
From: "VItoriaBr CEO (local)" <ceo-local@localhost>
Date: Thu, 26 Nov 2026 13:54:39 -0300
Subject: [PATCH 5/9] low ram: 1 MiB window grid under VICTORY_LOW_RAM

Title-memory windows (shadow.rs window()) were cut on a 4 MiB grid by
default, so a window holds what is read plus the rest of its 4 MiB. With
VICTORY_LOW_RAM on and no VICTORY_WINDOW_KB, the grid is 1 MiB. An ask
without a length keeps the 4 MiB grid, as before.

Cost: more windows to track. Disable alone with VICTORY_WINDOW_KB=4096
or VICTORY_LOW_RAM=0.
---
 crates/victory-gpu/src/shadow.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/crates/victory-gpu/src/shadow.rs b/crates/victory-gpu/src/shadow.rs
index f18d7b3..0d5de16 100644
--- a/crates/victory-gpu/src/shadow.rs
+++ b/crates/victory-gpu/src/shadow.rs
@@ -5232,13 +5232,16 @@ const WINDOW: u64 = 4 << 20;
 /// window ends nearer to what is read. An ask without a length keeps the
 /// 4 MiB grid whatever is set: a root view reads from its address to its
 /// window's end, and mesh streams bound that way reach megabytes.
-/// shortcut: the default stays 4 MiB until a run with the memory line's
+/// shortcut: the default stays 4 MiB (1 MiB with `VICTORY_LOW_RAM`) until a run with the memory line's
 /// window counts has shown what the finer grids give; the same memory
 /// asked for with different ranges then lies in more than one window.
 fn window() -> u64 {
     static GRID: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
     *GRID.get_or_init(|| {
         let kb = std::env::var("VICTORY_WINDOW_KB").ok().and_then(|v| v.trim().parse::<u64>().ok());
+        // With VICTORY_LOW_RAM on (crate::low_ram) and no VICTORY_WINDOW_KB: a
+        // 1 MiB grid, so that a window ends nearer to what is read.
+        let kb = kb.or(crate::low_ram::low_ram().then_some(1024));
         grid(kb)
     })
 }
